# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Google Gemini
# ============================================
GOOGLE_API_KEY=your_gemini_api_key

# ============================================
# Upstash Redis (Rate Limiting)
# ============================================
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================
# Langfuse (Observability) - Optional for now
# ============================================
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public contact shown on legal/privacy pages (required before public launch)
NEXT_PUBLIC_LEGAL_EMAIL=your_contact_email@example.com

# ============================================
# AI Multi-Provider Routing & Fallback
# ============================================
AI_TEXT_PROVIDER_ORDER=gemini,groq,mistral
AI_FALLBACK_ENABLED=true
AI_MAX_PROVIDERS_PER_REQUEST=2

# Direct Providers
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_CHAT_MODEL=
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=

# Gateway Providers (Opt-in via AI_TEXT_PROVIDER_ORDER)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=SynapseDoc
HUGGINGFACE_TOKEN=
HUGGINGFACE_CHAT_MODEL=

# Cloudflare Workers AI (Opt-in via AI_TEXT_PROVIDER_ORDER)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=

# Optional Reranking (Cohere v2)
COHERE_API_KEY=
COHERE_RERANK_MODEL=
AI_RERANK_ENABLED=false
AI_RERANK_PROVIDER=cohere